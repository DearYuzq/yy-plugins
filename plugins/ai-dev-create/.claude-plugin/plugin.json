{
  "name": "ai-dev-create",
  "version": "2.2.2",
  "description": "约束求解驱动的多阶段开发插件：分散发散→收敛验证→约束提取→TDD闭环→自我进化",
  "author": {
    "name": "yuzq",
    "url": "https://github.com/yuzq"
  },
  "homepage": "https://github.com/yuzq/ai-dev-create#readme",
  "repository": "https://github.com/yuzq/ai-dev-create",
  "license": "MIT",
  "keywords": [
    "sdd",
    "tdd",
    "multi-agent",
    "orchestration",
    "constraint-solving",
    "divergent",
    "convergent",
    "red-team",
    "blue-team",
    "springboot",
    "typescript",
    "python",
    "lessons-learned"
  ],
  "mcpServers": "./.mcp.json",
  "userConfig": {
    "defaultFlow": {
      "type": "string",
      "title": "默认开发流程",
      "description": "默认开发流程: quick (TDD快速), standard (SDD标准), full (SDD完整)",
      "default": "standard",
      "sensitive": false
    },
    "autoSaveSession": {
      "type": "boolean",
      "title": "自动保存会话",
      "description": "是否自动保存会话状态",
      "default": true,
      "sensitive": false
    }
  }
}