{
  "name": "ai-dev-create",
  "version": "2.1.0",
  "description": "多阶段需求澄清 + SDD/TDD 开发插件，支持发散→收敛流程、多 Agent 协作和按需加载",
  "author": {
    "name": "yuzq"
  },
  "license": "MIT",
  "agents": ["./agents"],
  "skills": ["./skills"],
  "commands": ["./commands"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/quality-check.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-save.js\""
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "github": {
      "command": "gh",
      "args": ["mcp", "start"],
      "description": "GitHub API 集成，支持 PR、Issue、代码审查等"
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@anthropic/context7-mcp-server"],
      "description": "最新文档查询，支持各种库和框架"
    }
  },
  "keywords": ["sdd", "tdd", "multi-agent", "orchestration", "clarification", "divergent", "convergent", "red-team", "blue-team", "springboot", "typescript", "python"],
  "repository": "https://github.com/yuzq/ai-dev-create"
}
