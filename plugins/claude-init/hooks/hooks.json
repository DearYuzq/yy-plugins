{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-check.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "检查当前编辑的文件类型和上下文。如果是代码修改，确保已加载 quality-standards.md 规则（质量标准）。如果是复杂修改（涉及多文件或架构决策），确保已加载 planning-first.md 规则（规划为王）。"
          }
        ]
      },
      {
        "matcher": "Bash.*git.*commit",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Git 提交前检查：确保已加载 quality-standards.md 规则，验证代码是否通过测试、是否符合质量标准。提醒运行测试并对比主干代码差异。"
          }
        ]
      },
      {
        "matcher": "Bash.*test",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "测试场景：确保已加载 quality-standards.md 规则。分析测试结果，如有失败则定位问题并修复。如果错误较多（>5个），考虑启动专门的错误修复 Agent。"
          }
        ]
      },
      {
        "matcher": "Bash.*pm2|Bash.*docker.*restart",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "服务调试场景：建议加载 service-mgmt.md 规则。使用 PM2/Docker 命令查看日志、分析问题、自主调试。"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "使用子智能体：确保已加载 subagent-strategy.md 规则。检查是否给 Agent 分配了明确的单一任务，是否限定了返回格式和可用工具。"
          }
        ]
      },
      {
        "matcher": "TaskCreate|TaskUpdate",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "任务管理场景：确保已加载 planning-first.md 规则。每个任务应在 .claude/dev/active/{任务名}/ 下创建 plan/context/tasks 三文档。"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash.*git",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Git 操作完成：检查是否影响了 CLAUDE.md 或规则文件（.claude/rules/、.claude/dev/）。如有变更，建议运行 /cc-update 同步更新。"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "代码修改完成：检查是否需要根据 self-improve.md 规则记录经验教训。如有用户修正或重要发现，更新到 .claude/lessons.md。"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/rule-recommender.sh\""
          }
        ]
      }
    ]
  }
}